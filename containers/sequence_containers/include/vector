#ifndef __VECTOR__
#define __VECTOR__

#include <cstddef>

namespace my_lib {
	template<class T, std::size_t N>
    class vector {
        public:
            vector(std::size_t s): elem{ new T[s] }, sz{s} {}
            double& operator[](std::size_t i) { return elem[i]; }
            std::size_t size() { return sz; }
        private:
            T* elem;
            std::size_t sz;
    }
}

#endif
