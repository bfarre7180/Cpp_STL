#ifndef __VECTOR__
#define __VECTOR__

#include <cstddef>
#include <initializer_list>
#include <stdexcept>
#include <iostream>

namespace my_lib {
	template<class T>
    class vector {

        public:

	    vector() : elem{nullptr}, sz{0} {}

            vector( std::size_t s ): elem{ new T[s] }, sz{s} {
                for (std::size_t i = 0; i < s; i++) {
                    elem[i] = 0;
                }
            }
            vector( std::initializer_list<T> list ): elem{ new T[list.size()] }, sz{ list.size() } {
                std::size_t i = 0;
                for (const T& val: list) {
                    elem[i] = val;
                    ++i;
                }
            }

            ~vector() { delete[] elem; }


            constexpr T& operator[]( const std::size_t i ) {
                if (i >= sz)
                    throw std::out_of_range{"Vector::operator[]"};
                return elem[i];
            }
            constexpr const T& operator[]( const std::size_t i ) const {
                if (i >= sz)
                    throw std::out_of_range{"Vector::operator[]"};
                return elem[i];
            }

            constexpr bool operator==( const vector<T>& other ) const {
                if ( sz != other.size() ) {
                    return false;
                }

                for ( std::size_t i = 0; i < sz; i++ ) {
                    if ( elem[i] != other[i] ) {
                        return false;
                    }
                }

                return true;
            }

            constexpr void push_back( const T& val ) {

            }
            constexpr void push_back( T&& val ) {

            }

            std::size_t size() const { return sz; }

        private:
            T* elem;
            std::size_t sz;
    };
}

#endif
