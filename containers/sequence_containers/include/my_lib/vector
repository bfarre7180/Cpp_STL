#ifndef __VECTOR__
#define __VECTOR__

#include <cstddef>
#include <initializer_list>

namespace my_lib {
	template<class T>
    class vector {

        public:

            vector(std::size_t s): elem{ new T[s] }, sz{s} {}
            vector(std::initializer_list<T> list): elem{ new T[list.size()] }, sz{ list.size() } {
                std::size_t i = 0;
                for (const T& val: list) {
                    elem[i] = val;
                    ++i;
                }
            }


            T& operator[](std::size_t i) { return elem[i]; }
            std::size_t size() const { return sz; }

        private:
            T* elem;
            std::size_t sz;
    };
}

#endif
